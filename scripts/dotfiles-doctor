#!/usr/bin/env bash
set -euo pipefail

repo_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

ok_count=0
warn_count=0
fail_count=0

ok() {
  ok_count=$((ok_count + 1))
  printf "OK   %s\n" "$*"
}

warn() {
  warn_count=$((warn_count + 1))
  printf "WARN %s\n" "$*"
}

fail() {
  fail_count=$((fail_count + 1))
  printf "FAIL %s\n" "$*"
}

has_cmd() { command -v "$1" >/dev/null 2>&1; }

realpath_f() {
  if has_cmd realpath; then
    realpath -m "$1"
  else
    python3 - <<'PY' "$1"
import os, sys
print(os.path.realpath(sys.argv[1]))
PY
  fi
}

run_cmd_capture() {
  local label="$1"
  shift

  local out
  out="$(mktemp)"
  if "$@" >"$out" 2>&1; then
    ok "$label: ok"
    rm -f "$out"
    return 0
  fi

  fail "$label: failed"
  sed -n '1,40p' "$out" | sed 's/^/  /'
  rm -f "$out"
  return 1
}

check_cmd() {
  local cmd="$1"
  if has_cmd "$cmd"; then
    ok "cmd: $cmd ($(command -v "$cmd"))"
  else
    fail "cmd: $cmd (missing)"
  fi
}

check_symlink_into_repo() {
  local path="$1"
  local label="${2:-$1}"
  if [ ! -e "$path" ]; then
    warn "$label: missing ($path)"
    return 0
  fi
  if [ ! -L "$path" ]; then
    warn "$label: exists but is not a symlink ($path)"
    return 0
  fi

  local target
  target="$(readlink -f "$path" 2>/dev/null || true)"
  if [ -z "$target" ]; then
    warn "$label: symlink target unreadable ($path)"
    return 0
  fi

  case "$target" in
    "$repo_dir"/*) ok "$label: linked into repo" ;;
    *) warn "$label: points outside repo -> $target" ;;
  esac
}

checksum() {
  if has_cmd sha256sum; then
    sha256sum "$1" | awk '{print $1}'
  else
    shasum -a 256 "$1" | awk '{print $1}'
  fi
}

check_managed_file() {
  local path="$1"
  local repo_path="$2"
  local label="${3:-$1}"

  if [ ! -e "$path" ]; then
    warn "$label: missing ($path)"
    return 0
  fi

  if [ -L "$path" ]; then
    check_symlink_into_repo "$path" "$label"
    return 0
  fi

  if [ ! -f "$repo_path" ]; then
    warn "$label: repo reference missing ($repo_path)"
    return 0
  fi

  if [ -f "$path" ]; then
    local a b
    a="$(checksum "$path")"
    b="$(checksum "$repo_path")"
    if [ "$a" = "$b" ]; then
      ok "$label: file matches repo (not symlinked)"
    else
      warn "$label: file differs from repo (not symlinked)"
    fi
    return 0
  fi

  warn "$label: exists but is not a regular file ($path)"
}

section() {
  printf "\n== %s ==\n" "$1"
}

section "Repo"
if [ -d "$repo_dir/.git" ]; then
  ok "repo: $repo_dir"
else
  fail "repo: not a git repo? ($repo_dir)"
fi

section "Stow"
check_cmd stow
for pkg in shell bash zsh git tmux nvim vim; do
  if [ -d "$repo_dir/$pkg" ]; then
    ok "package: $pkg/"
  else
    warn "package: $pkg/ missing"
  fi
done

section "git"
check_cmd git
if has_cmd git; then
  if [ -e "$HOME/.gitconfig" ]; then
    run_cmd_capture "git config (global)" git config --global --list
  else
    warn "git config (global): $HOME/.gitconfig missing (stow the git package?)"
  fi
fi

section "Symlinks (expected)"
check_symlink_into_repo "$HOME/.config/shell" "$HOME/.config/shell"
check_symlink_into_repo "$HOME/.config/starship.toml" "$HOME/.config/starship.toml"
check_symlink_into_repo "$HOME/.bash_aliases" "$HOME/.bash_aliases"
check_symlink_into_repo "$HOME/.zshrc" "$HOME/.zshrc"
check_symlink_into_repo "$HOME/.zshenv" "$HOME/.zshenv"
check_symlink_into_repo "$HOME/.tmux.conf" "$HOME/.tmux.conf"
check_symlink_into_repo "$HOME/.config/tmux" "$HOME/.config/tmux"
check_symlink_into_repo "$HOME/.config/nvim" "$HOME/.config/nvim"
check_symlink_into_repo "$HOME/.gitconfig" "$HOME/.gitconfig"
check_symlink_into_repo "$HOME/.config/git" "$HOME/.config/git"
check_symlink_into_repo "$HOME/.vimrc" "$HOME/.vimrc"

# Codex wrapper scripts are intentionally not shipped anymore. If you previously stowed them,
# you may have stale symlinks left behind.
for p in "$HOME/.local/bin/codex" "$HOME/.local/bin/codex-dotfiles"; do
  if [ -L "$p" ] && [ ! -e "$p" ]; then
    warn "stale symlink: $p (run: stow -R -t \"$HOME\" shell)"
  fi
done

section "Shell"
check_cmd bash
check_cmd zsh

if [ -f "$HOME/.bashrc" ]; then
  if rg -n "bash_aliases" "$HOME/.bashrc" >/dev/null 2>&1; then
    ok "$HOME/.bashrc sources $HOME/.bash_aliases"
  else
    warn "$HOME/.bashrc does not appear to source $HOME/.bash_aliases"
  fi
else
  warn "$HOME/.bashrc missing"
fi

if has_cmd getent; then
  user_name="${USER:-}"
  if [ -z "$user_name" ] && has_cmd id; then
    user_name="$(id -un 2>/dev/null || true)"
  fi

  if [ -n "$user_name" ]; then
    user_shell="$(getent passwd "$user_name" | cut -d: -f7 || true)"
    zsh_path="$(command -v zsh || true)"
    if [ -n "$user_shell" ] && [ -n "$zsh_path" ]; then
      if [ "$user_shell" = "$zsh_path" ]; then
        ok "login shell: $user_shell"
      else
        warn "login shell: $user_shell (zsh is $zsh_path; run: chsh -s \"$zsh_path\")"
      fi
    fi
  else
    warn "login shell: unable to determine user (USER unset)"
  fi
fi

if [ -n "${XDG_RUNTIME_DIR:-}" ]; then
  if [ -d "$XDG_RUNTIME_DIR" ] && [ -w "$XDG_RUNTIME_DIR" ]; then
    ok "XDG_RUNTIME_DIR: $XDG_RUNTIME_DIR (writable)"
  else
    warn "XDG_RUNTIME_DIR: $XDG_RUNTIME_DIR (not writable)"
  fi
else
  warn "XDG_RUNTIME_DIR is not set (shell env should set a fallback)"
fi

if [ -f "$HOME/.config/shell/env.sh" ]; then
  run_cmd_capture "sh syntax env.sh" sh -n "$HOME/.config/shell/env.sh"
fi
if [ -f "$HOME/.config/shell/functions.sh" ]; then
  run_cmd_capture "sh syntax functions.sh" sh -n "$HOME/.config/shell/functions.sh"
fi
if [ -f "$HOME/.config/shell/aliases.sh" ]; then
  run_cmd_capture "sh syntax aliases.sh" sh -n "$HOME/.config/shell/aliases.sh"
fi
if [ -f "$HOME/.bash_aliases" ]; then
  run_cmd_capture "bash syntax .bash_aliases" bash -n "$HOME/.bash_aliases"
fi
if has_cmd zsh; then
  if [ -f "$HOME/.zshenv" ]; then
    run_cmd_capture "zsh syntax .zshenv" zsh -n "$HOME/.zshenv"
  fi
  if [ -f "$HOME/.zshrc" ]; then
    run_cmd_capture "zsh syntax .zshrc" zsh -n "$HOME/.zshrc"
  fi
fi

section "Powerline"
case "${LANG:-}" in
  *UTF-8* | *utf8*)
  ok "locale: ${LANG:-} (UTF-8)"
  ;;
  *)
  warn "locale: ${LANG:-<unset>} (not UTF-8; powerline glyphs may render poorly)"
  ;;
esac

if has_cmd starship; then
  ok "starship: installed ($(command -v starship))"
else
  warn "starship: missing (optional; run: $repo_dir/scripts/install-starship)"
fi

if [ -n "${WT_SESSION:-}" ]; then
  ok "terminal: Windows Terminal (WT_SESSION set)"
else
  warn "terminal: WT_SESSION not set (if using Windows Terminal, ensure it passes WT_SESSION)"
fi

ok "glyph test: run $repo_dir/scripts/powerline-test (visual check for Nerd Font separators/icons)"

section "tmux"
check_cmd tmux
if has_cmd tmux; then
  ok "$(tmux -V)"
  if tmux list-commands 2>/dev/null | grep -Eq '^display-popup([[:space:]]|$)'; then
    ok "tmux popup: supported (display-popup)"
  else
    warn "tmux popup: not supported (tmux < 3.2; Prefix+P requires display-popup)"
  fi
  if [ -f "$HOME/.config/tmux/tmux.conf" ]; then
    tmux_tmpdir=""
    state_home="${XDG_STATE_HOME:-$HOME/.local/state}"
    state_run="$state_home/run"
    mkdir -p "$state_run" >/dev/null 2>&1 || true

    if [ -d "$state_run" ] && [ -w "$state_run" ]; then
      tmux_tmpdir="$state_run"
    elif [ -n "${TMUX_TMPDIR:-}" ] && [ -d "${TMUX_TMPDIR:-}" ] && [ -w "${TMUX_TMPDIR:-}" ]; then
      tmux_tmpdir="$TMUX_TMPDIR"
    else
      warn "tmux tmp dir: not writable; skipping tmux config parse"
    fi

    if [ -n "$tmux_tmpdir" ]; then
      ok "tmux tmp dir: $tmux_tmpdir"
      tmux_out="$(mktemp)"
      if env TMUX_TMPDIR="$tmux_tmpdir" tmux -f "$HOME/.config/tmux/tmux.conf" -L dotfiles_doctor start-server >"$tmux_out" 2>&1; then
        ok "tmux config parse: ok"
      else
        if grep -Eiq "(Operation not permitted|Permission denied)" "$tmux_out"; then
          warn "tmux config parse: skipped (sandbox blocked tmux server)"
          sed -n '1,5p' "$tmux_out" | sed 's/^/  /'
        else
          fail "tmux config parse: failed"
          sed -n '1,40p' "$tmux_out" | sed 's/^/  /'
        fi
      fi
      rm -f "$tmux_out"

      env TMUX_TMPDIR="$tmux_tmpdir" tmux -L dotfiles_doctor kill-server >/dev/null 2>&1 || true
    fi
  fi
fi
if [ -f "$HOME/.config/tmux/plugins/tpm/tpm" ]; then
  ok "tpm: installed"
else
  warn "tpm: missing (run: git -C \"$repo_dir\" submodule update --init --recursive)"
fi

section "Neovim"
check_cmd nvim
check_cmd rg
check_cmd fzf
if has_cmd fd; then
  ok "cmd: fd ($(command -v fd))"
else
  if has_cmd fdfind; then
    warn "cmd: fd (missing; Ubuntu provides fdfind: $(command -v fdfind); run: ln -sf \"$(command -v fdfind)\" \"$HOME/.local/bin/fd\")"
  else
    fail "cmd: fd (missing)"
  fi
fi

if has_cmd fzf; then
  fzf_version="$(fzf --version 2>/dev/null | awk '{print $1}' || true)"
  if [ -n "${fzf_version:-}" ]; then
    if printf "%s\n%s\n" "0.36.0" "$fzf_version" | sort -V -C; then
      ok "fzf version: $fzf_version (>= 0.36.0)"
    else
      warn "fzf version: $fzf_version (< 0.36.0; fzf-lua will abort; run: $repo_dir/scripts/install-fzf)"
    fi
  fi
fi

if has_cmd nvim; then
  nvim_path="$(command -v nvim)"
  ok "nvim path: $nvim_path"
  if [ "$(realpath_f "$nvim_path")" = "$(realpath_f "$HOME/.local/bin/nvim")" ]; then
    ok "nvim is user-local (~/.local/bin/nvim)"
  else
    warn "nvim is not ~/.local/bin/nvim (expected local install via scripts/install-nvim)"
  fi

  run_cmd_capture "nvim headless" nvim --headless '+lua print("headless_ok")' +qa

  if [ -d "$HOME/.local/share/nvim/lazy/lualine.nvim" ]; then
    run_cmd_capture "nvim lualine config" nvim --headless '+lua require("lualine")' +qa
  fi
  if [ -d "$HOME/.local/share/nvim/lazy/catppuccin" ]; then
    run_cmd_capture "nvim catppuccin config" nvim --headless '+lua require("catppuccin")' +qa
  fi
fi

if [ -d "$HOME/.local/share/nvim/lazy/lazy.nvim" ]; then
  ok "lazy.nvim: installed"
else
  warn "lazy.nvim: not installed yet (open nvim or run: nvim --headless '+Lazy! sync' +qa)"
fi

if [ -d "$HOME/.local/share/nvim/lazy/lualine.nvim" ]; then
  ok "lualine.nvim: installed"
else
  warn "lualine.nvim: not installed yet (open nvim to sync plugins)"
fi

section "Airlock (optional)"
if has_cmd airlock || has_cmd yolo; then
  if has_cmd airlock; then
    ok "cmd: airlock ($(command -v airlock))"
  else
    warn "cmd: airlock (missing; but yolo is present)"
  fi
  if has_cmd yolo; then
    ok "cmd: yolo ($(command -v yolo))"
  else
    warn "cmd: yolo (missing; but airlock is present)"
  fi

  check_managed_file "$HOME/.airlock/config.toml" "$repo_dir/shell/.airlock/config.toml" "$HOME/.airlock/config.toml"

  if has_cmd python3; then
    if python3 - <<'PY' >/dev/null 2>&1
import sys
try:
    import tomllib  # py311+
except Exception:
    import tomli  # py310 + pip
sys.exit(0)
PY
    then
      ok "airlock config.toml parser: python3 tomllib/tomli available"
    else
      warn "airlock config.toml parser: missing (need python3.11 tomllib or install tomli; otherwise Airlock ignores ~/.airlock/config.toml)"
    fi
  else
    warn "airlock config.toml parser: python3 missing (Airlock may ignore ~/.airlock/config.toml)"
  fi
else
  warn "airlock: not installed (optional)"
fi

printf "\nSummary: %d ok, %d warn, %d fail\n" "$ok_count" "$warn_count" "$fail_count"
if [ "$fail_count" -gt 0 ]; then
  exit 1
fi
