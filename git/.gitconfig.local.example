# Local, untracked git overrides (example)
#
# Create `~/.gitconfig.local` and put machine-specific settings here.
# This repo intentionally does not track that file (identity/credentials are personal).

[user]
	name = Example Name
	email = name@example.com

# Optional: credentials (choose an applicable method)
#
# Windows Git Credential Manager (recommended on native Windows)
#[credential]
#	helper = manager-core
#
# GitHub CLI (works cross-platform if `gh` is on PATH)
#[credential "https://github.com"]
#	helper =
#	helper = !gh auth git-credential
#[credential "https://gist.github.com"]
#	helper =
#	helper = !gh auth git-credential
#
# Azure DevOps sometimes wants the full URL path for credentials
#[credential "https://dev.azure.com"]
#	useHttpPath = true
